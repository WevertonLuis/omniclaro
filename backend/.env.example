# ============================================================
# OmniClaro - variaveis de ambiente
# Copie este arquivo para  backend/.env  e preencha a GEMINI_API_KEY
# ============================================================

# ---------- Motor de NLU (unica chamada externa real do projeto) ----------
# Obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Gemini 3.x raciocina antes de responder por padrao (~20s). "low" derruba para ~1,3s.
# Deixe vazio se trocar para um modelo fora da familia 3.x.
GEMINI_THINKING_LEVEL=low

# ---------- Persistencia relacional ----------
# sqlite  -> arquivo local via sql.js (WASM, nao exige compilacao nativa)  [modo npm run dev]
# postgres-> usa as variaveis PG* abaixo                                   [modo docker-compose]
DB_DRIVER=sqlite
DB_SQLITE_FILE=./data/omniclaro.db
PGHOST=localhost
PGPORT=5432
PGUSER=omniclaro
PGPASSWORD=omniclaro
PGDATABASE=omniclaro

# ---------- Sessao / contexto ----------
# memory -> Map em memoria com a mesma interface do ioredis  [modo npm run dev]
# redis  -> Redis real via ioredis                            [modo docker-compose]
CACHE_DRIVER=memory
REDIS_HOST=localhost
REDIS_PORT=6379
SESSION_TTL_SECONDS=86400

# ---------- Servidor ----------
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Regras de negocio ----------
# Abaixo deste score de confianca o orquestrador aciona transbordo humano
HANDOFF_CONFIDENCE_THRESHOLD=0.80
